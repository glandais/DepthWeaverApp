{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A circle with a number inside. The argument is the step number."
    },
    "%@: %@" : {
      "comment" : "A label and slider pair. The label shows the parameter name and its current value. The slider allows the user to adjust the parameter value. The argument is the string “Density”, the string “Dot Size”, the string “Frequency”, the string “Octaves”, the string “Persistence”, the string “Hue”, the string “Cell Size”, the string “Cell Count”, the string “Jitter”, the string “Edge Width”, the string “Feed Rate (F)”, the string “Kill Rate (k)” or the string “Iterations”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%d/%d (Format, # of Images)" : {
      "comment" : "Images taken over maximum number of images.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$d/%2$d"
          }
        }
      }
    },
    "Aim at your object (Object Capture)" : {
      "comment" : "Feedback message to aim at your object for object capture",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Aim at your object"
          }
        }
      }
    },
    "Aligning Images (Reconstruction)" : {
      "comment" : "Feedback message during the object reconstruction phase.",
