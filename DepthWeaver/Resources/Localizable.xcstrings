    "help.step_acquire_full" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a depth source: LiDAR Scan (Pro devices), From Photo (AI estimation), 3D Model, Capture 3D (scan a real object, Pro devices), Depth Map Presets, or Import a grayscale depth map (white = close, black = far)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une source de profondeur : Scan LiDAR (appareils Pro), Depuis une photo (estimation IA), Modèle 3D, Capturer en 3D (scan d'un objet réel, appareils Pro), Exemples, ou Importer une carte en niveaux de gris (blanc = proche, noir = loin)."
          }
        }
      }
    },
    "help.step_adjust_depth" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the 3D preview to refine the depth: crop the input range, remap the output, or enable Denoising to clean up noisy depth maps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l'aperçu 3D pour affiner la profondeur : recadrez la plage d'entrée, remappez la sortie, ou activez le débruitage pour nettoyer les cartes bruitées."
          }
        }
      }
    },
    "help.step_adjust_settings" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tune DPI (resolution), Depth strength (3D intensity), Depth range (separation), and Smoothness (sampling quality). Toggle Invert if needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez le DPI (résolution), l'intensité de profondeur (intensité 3D), la plage de profondeur (séparation) et le lissage (qualité d'échantillonnage). Activez l'inversion si nécessaire."
          }
        }
      }
    },
    "help.step_choose_pattern" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a built-in texture, import your own photo, or generate a procedural pattern (stars, etc.) with adjustable parameters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une texture intégrée, importez votre propre photo, ou générez un motif procédural (étoiles, etc.) avec des paramètres ajustables."
          }
        }
      }
    },
    "help.step_share" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the stereogram preview to view it full screen, then share or save it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l'aperçu du stéréogramme pour le voir en plein écran, puis partagez-le ou enregistrez-le."
          }
        }
      }
    },
    "help.tip_device_close" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: It helps to start with the device close to your face, then slowly move it away while keeping your eyes relaxed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseil : commencez avec l'appareil près de votre visage, puis éloignez-le lentement en gardant les yeux détendus."
          }
        }
      }
    },
    "help.tip_device_close_alt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Start with the device close to your face, then slowly move it away while keeping your eyes relaxed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseil : commencez avec l'appareil près de votre visage, puis éloignez-le lentement en gardant les yeux détendus."
          }
        }
      }
    },
    "help.view_step_adjust" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you see the 3D image, you can slowly adjust your distance to sharpen it"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois l'image 3D visible, vous pouvez ajuster lentement la distance pour la rendre plus nette"
          }
        }
      }
    },
    "help.view_step_hold" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold your device at arm's length"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez votre appareil à bout de bras"
          }
        }
