    },
    "trainer.step1_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your elbow. Keep the screen flat and straight in front of you — no tilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez votre coude. Gardez l’écran bien à plat face à vous, sans l’incliner."
          }
        }
      }
    },
    "trainer.step1_primary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis prêt"
          }
        }
      }
    },
    "trainer.step1_secondary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip the trainer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer l’entraînement"
          }
        }
      }
    },
    "trainer.step1_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold it at arm's length"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-le à bout de bras"
          }
        }
      }
    },
    "trainer.step2_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let your eyes go lazy, as if something far behind the phone had your attention."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vos yeux se relâcher, comme si quelque chose loin derrière le téléphone vous intéressait."
          }
        }
      }
    },
    "trainer.step2_primary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My eyes are relaxed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes yeux sont détendus"
          }
        }
      }
    },
    "trainer.step2_secondary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retour"
          }
        }
      }
    },
    "trainer.step2_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look through the screen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez à travers l’écran"
          }
        }
      }
    },
    "trainer.step3_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pattern will split into two overlapping copies. Hold it there — don't chase it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le motif va se dédoubler en deux copies superposées. Tenez bon — ne le poursuivez pas."
          }
        }
      }
    },
    "trainer.step3_primary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I see doubles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vois double"
          }
        }
      }
    },
    "trainer.step3_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the dots double up"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le motif se dédoubler"
          }
        }
      }
    },
    "trainer.step4_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once depth appears, blink slowly to keep it. Each round gets a little harder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que le relief apparaît, clignez lentement pour le garder. Chaque tour est un peu plus dur."
          }
        }
      }
    },
    "trainer.step4_primary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I see it — next round"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je le vois — tour suivant"
          }
        }
      }
    },
    "trainer.step4_secondary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still nothing"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours rien"
          }
        }
      }
    },
    "trainer.step4_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sphere should lift out"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sphère doit surgir"
          }
        }
      }
    },
