    "help.view_step_overlap" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The repeating pattern will overlap. Keep your gaze relaxed until a 3D shape emerges"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le motif répété va se superposer. Gardez le regard détendu jusqu'à ce qu'une forme 3D apparaisse"
