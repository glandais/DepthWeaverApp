    "help.step_acquire_full" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquire a depth map using LiDAR Scan (Pro devices), From Photo (AI depth estimation), or Import Depth Map (grayscale image where white = close, black = far)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquérir une carte de profondeur avec Scan LiDAR (appareils Pro), Depuis une photo (estimation IA de la profondeur), ou Importer carte de profondeur (image en niveaux de gris où blanc = proche, noir = loin)"
          }
        }
      }
    },
    "help.step_adjust_depth" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the depth preview or \"Adjust Depth\" to focus on a depth range — crop the input and remap the output for better contrast"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l'aperçu de profondeur ou « Ajuster la profondeur » pour cibler une plage de profondeur — recadrez l'entrée et remappez la sortie pour un meilleur contraste"
          }
        }
      }
    },
    "help.step_adjust_settings" : {
