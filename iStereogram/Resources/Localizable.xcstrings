          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A label and slider pair. The label shows the parameter name and its current value. The slider allows the user to adjust the parameter value. The argument is the string “Density”, the string “Dot Size”, the string “Frequency”, the string “Octaves”, the string “Persistence”, the string “Hue”, the string “Cell Size”, the string “Cell Count”, the string “Jitter”, the string “Edge Width”, the string “Feed Rate (F)”, the string “Kill Rate (k)” or the string “Iterations”.",
